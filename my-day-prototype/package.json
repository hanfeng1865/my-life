{
  "name": "my-day-prototype",
  "productName": "我的人生",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.weila.myday",
    "productName": "我的人生",
    "files": [
      "package.json",
      "electron/**/*",
      "dist/client/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "icon": "build/my-life.icns"
    }
  }
}
